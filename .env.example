NODE_ENV=production
APP_URL=https://automotosourcing.com
# Hostinger supplies PORT; do not hardcode a different value in hPanel.
# PORT=3000
# Set only after verifying the proxy chain / rate limit behavior in Hostinger.
TRUST_PROXY_HOPS=1
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# For a remote database require TLS; local Hostinger MySQL normally uses localhost.
DB_SSL=false
ADMIN_EMAIL=
# Generate interactively with npm run admin:hash. No default password exists.
ADMIN_PASSWORD_HASH=
# Notifications remain queued until the business mailbox and recipient are confirmed.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=parts@automotosourcing.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=parts@automotosourcing.com
# Optional: when empty, notifications go to ADMIN_EMAIL.
INQUIRY_NOTIFICATION_EMAIL=
