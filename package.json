{
  "name": "auto-parts-purchasing",
  "version": "2.0.0",
  "private": true,
  "description": "Independent automotive and motorcycle aftermarket sourcing website",
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "dev:orders": "node source/scripts/serve-orders.mjs",
    "build": "node source/scripts/build.mjs",
    "build:hostinger": "node source/scripts/build.mjs",
    "check": "node source/scripts/check.mjs",
    "test": "node --test source/scripts/inquiry.test.mjs source/scripts/delivery.test.mjs",
    "test:receipt": "node --test source/scripts/receipt.test.mjs",
    "test:orders": "node --test source/scripts/orders.test.mjs",
    "test:search": "node --test source/scripts/search.test.mjs",
    "start": "node server.js",
    "dev:static": "node source/scripts/serve.mjs",
    "build:legacy-php": "node source/scripts/build-legacy.mjs --hostinger",
    "test:integration": "node --test source/tests/integration.test.mjs",
    "test:browser": "node source/tests/browser.mjs",
    "admin:hash": "node source/scripts/admin-hash.mjs",
    "check:deployment": "node source/scripts/check-deployment.mjs",
    "mail:verify": "node source/scripts/verify-mail.mjs"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "smtp-server": "^3.19.24"
  }
}
